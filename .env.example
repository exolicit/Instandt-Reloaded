# Supabase (Projekt-Einstellungen → API). Beide Werte sind öffentlich (Browser-sicher).
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Alternativ (ältere Projekte / Vercel-Integration setzt diesen Namen):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...

# Optional, nur serverseitig, NIEMALS in den Browser und NIEMALS in die Claude-Session:
# SUPABASE_SERVICE_ROLE_KEY=...
